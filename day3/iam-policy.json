{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SetupIamForLabRolesOnly",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole", "iam:GetRole", "iam:DeleteRole", "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy", "iam:GetRolePolicy", "iam:DeleteRolePolicy", "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies", "iam:DetachRolePolicy", "iam:PassRole", "iam:ListRoles"
      ],
      "Resource": "arn:aws:iam::*:role/ajou-aisec3x-*"
    },
    {
      "Sid": "AssumeGuardrailEnforcedRole",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::*:role/ajou-aisec3x-*-guardrail-enforced"
    },
    {
      "Sid": "LabServices",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream",
        "bedrock:CreateGuardrail", "bedrock:UpdateGuardrail", "bedrock:CreateGuardrailVersion", "bedrock:GetGuardrail",
        "bedrock:ListGuardrails", "bedrock:DeleteGuardrail", "bedrock:ApplyGuardrail",
        "bedrock:CreateKnowledgeBase", "bedrock:GetKnowledgeBase", "bedrock:DeleteKnowledgeBase",
        "bedrock:CreateDataSource", "bedrock:StartIngestionJob", "bedrock:GetIngestionJob", "bedrock:Retrieve",
        "bedrock:GetModelInvocationLoggingConfiguration",
        "bedrock-agentcore:*",
        "cognito-idp:*",
        "dynamodb:CreateTable", "dynamodb:DescribeTable", "dynamodb:UpdateTimeToLive", "dynamodb:DeleteTable",
        "dynamodb:PutItem", "dynamodb:GetItem", "dynamodb:UpdateItem", "dynamodb:Query",
        "secretsmanager:CreateSecret", "secretsmanager:DescribeSecret", "secretsmanager:GetSecretValue", "secretsmanager:DeleteSecret",
        "s3:CreateBucket", "s3:PutObject", "s3:GetObject", "s3:ListBucket", "s3:DeleteObject", "s3:DeleteBucket",
        "s3vectors:*",
        "lambda:CreateFunction", "lambda:GetFunction", "lambda:DeleteFunction", "lambda:InvokeFunction", "lambda:AddPermission",
        "events:PutRule", "events:PutTargets", "events:PutEvents", "events:RemoveTargets", "events:DeleteRule",
        "logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents", "logs:PutRetentionPolicy", "logs:DeleteLogGroup",
        "logs:StartQuery", "logs:GetQueryResults", "logs:FilterLogEvents", "logs:PutResourcePolicy",
        "logs:PutDataProtectionPolicy", "logs:DeleteDataProtectionPolicy",
        "xray:GetTraceSegmentDestination", "xray:UpdateTraceSegmentDestination",
        "cloudwatch:PutMetricData", "cloudwatch:PutMetricAlarm", "cloudwatch:DescribeAlarms", "cloudwatch:DeleteAlarms",
        "cloudwatch:ListMetrics", "cloudwatch:GetMetricStatistics", "cloudwatch:GetMetricData",
        "ec2:DescribeVpcEndpointServices", "ec2:CreateVpc", "ec2:ModifyVpcAttribute", "ec2:DescribeVpcs", "ec2:DeleteVpc",
        "ec2:CreateSubnet", "ec2:DeleteSubnet", "ec2:CreateSecurityGroup", "ec2:AuthorizeSecurityGroupIngress",
        "ec2:DeleteSecurityGroup", "ec2:CreateVpcEndpoint", "ec2:ModifyVpcEndpoint", "ec2:DescribeVpcEndpoints",
        "ec2:DeleteVpcEndpoints", "ec2:DescribeNetworkInterfaces", "ec2:DeleteNetworkInterface", "ec2:CreateTags",
        "access-analyzer:ValidatePolicy", "access-analyzer:CheckAccessNotGranted", "access-analyzer:CheckNoNewAccess",
        "cloudtrail:DescribeTrails"
      ],
      "Resource": "*"
    }
  ]
}
